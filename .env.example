# Local connection settings; generate credentials locally. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=
POSTGRES_DB=hsm
POSTGRES_USER=hsm
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
CHAT_SEND_RATE_LIMIT=30
JWT_SECRET=
CNIC_HASH_KEY=
CNIC_ENCRYPTION_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=hsm-private
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_PASSWORD=
SENTRY_DSN=
# Server-only web proxy target and exact browser origin.
API_ORIGIN=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development


# API environment (development/test/staging/production); explicit trusted proxy IPs only.
APP_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated reverse-proxy addresses (edge proxy and the web BFF) whose X-Forwarded-For
# is honoured; leave empty when the API is not behind a proxy.
TRUST_PROXY=
BODY_LIMIT_BYTES=1048576
GLOBAL_RATE_LIMIT=120
LOG_LEVEL=info

# Auth IP quota per minute; per-route normalized identifier quota per ten minutes.
AUTH_IP_RATE_LIMIT=30
AUTH_IDENTIFIER_RATE_LIMIT=5

# Optional public Sentry DSN; never an auth token. Blank disables API and web server telemetry.
SENTRY_DSN=

# Optional public browser Sentry DSN, validated before extending connect-src.
# The browser environment is set from APP_ENV at web build time.
NEXT_PUBLIC_SENTRY_DSN=
# Optional public mobile telemetry key; never an upload/authentication secret.
EXPO_PUBLIC_SENTRY_DSN=

# Exact browser-reachable private S3 origin, matching S3_PUBLIC_ENDPOINT when configured.
# Configure bucket CORS for WEB_ORIGIN: PUT and content-type only; keep the bucket private.
WEB_UPLOAD_ORIGIN=http://localhost:9000

# Marketplace text matching around approved directory places; meters, not a booking-policy default.
MARKETPLACE_TEXT_RADIUS_METERS=5000

# Approved Phase 3 visit lifecycle and follow-up delivery; false explicitly disables both runtimes.
VISITS_ENABLED=true

# Enable only after approved profile-review schema/immutable guards are deployed.
PROFILE_REVIEWS_ENABLED=false
