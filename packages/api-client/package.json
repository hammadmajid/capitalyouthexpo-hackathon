{
  "name": "@hsm/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "client:generate": "node scripts/generate.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run --coverage",
    "coverage:unit": "vitest run --config vitest.aggregate.config.ts",
    "test:visits": "vitest run --coverage src/visits.spec.ts src/visit-command.spec.ts src/visit-history.spec.ts src/visit-interest.spec.ts"
  },
  "dependencies": {
    "@hsm/contracts": "workspace:*",
    "openapi-fetch": "catalog:",
    "socket.io-client": "4.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hsm/config": "workspace:*",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
