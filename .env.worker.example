# Worker-only settings. Copy to ignored .env.worker; never include CNIC keys.
NODE_ENV=development
APP_ENV=development
DATABASE_URL=
REDIS_URL=redis://localhost:6379
EMAIL_ENVELOPE_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LOG_LEVEL=info

# Private file scan processing; never place CNIC encryption/HMAC keys in this file.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=hsm-private
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
