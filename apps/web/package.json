{
  "name": "@hsm/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env .next/standalone/apps/web/server.js",
    "build": "node scripts/build.mjs",
    "lint": "eslint src test scripts *.ts *.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "coverage:unit": "vitest run --config vitest.aggregate.config.ts",
    "test:visits": "vitest run --coverage src/components/visits.spec.tsx"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@hookform/resolvers": "catalog:",
