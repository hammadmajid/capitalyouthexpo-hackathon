    "@hsm/contracts": "workspace:*",
    "@hsm/observability": "workspace:*",
    "@hsm/ui": "workspace:*",
    "@radix-ui/react-slot": "1.5.0",
    "@sentry/browser": "11.15.0",
    "@sentry/node": "11.15.0",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.76.0",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "tailwind-merge": "2.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@hsm/config": "workspace:*",
    "@hsm/db": "workspace:*",
    "@hsm/test-support": "workspace:*",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "argon2": "catalog:",
    "autoprefixer": "10.7.0",
    "drizzle-orm": "catalog:",
    "jsdom": "30.1.2",
    "postcss": "8.5.33",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
