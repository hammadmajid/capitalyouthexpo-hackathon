    "dev": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start",
    "lint": "eslint src scripts *.ts *.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:components": "jest --runInBand",
    "build": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli export --platform android --output-dir dist",
