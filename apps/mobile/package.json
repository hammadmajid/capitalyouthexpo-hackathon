    "android:debug": "node scripts/android-debug.mjs",
    "test:native": "node scripts/native-smoke.ts",
    "coverage:unit": "vitest run --config vitest.aggregate.config.ts",
    "coverage:components": "jest --runInBand --config jest.aggregate.config.cjs",
    "test:visits": "jest --runInBand src/components/visits.component.spec.tsx"
  },
