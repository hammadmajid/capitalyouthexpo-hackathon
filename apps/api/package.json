{
  "name": "@hsm/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts *.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "api:generate": "node scripts/openapi.ts",
    "test:containers": "vitest run --config vitest.containers.config.ts",
    "coverage:unit": "vitest run --config vitest.aggregate.config.ts",
    "coverage:integration": "vitest run --config vitest.aggregate.integration.config.ts",
    "test:visits": "vitest run --config vitest.config.ts --coverage src/visits test/api/visits.spec.ts"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/static": "catalog:",
    "@hsm/contracts": "workspace:*",
    "@hsm/db": "workspace:*",
    "@hsm/files": "workspace:*",
    "@hsm/notifications": "workspace:*",
    "@hsm/observability": "workspace:*",
    "@hsm/security": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@sentry/node": "11.15.0",
    "argon2": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "4.8.4",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@hsm/config": "workspace:*",
    "@hsm/test-support": "workspace:*",
    "socket.io-client": "4.8.4",
    "testcontainers": "catalog:"
  }
}
